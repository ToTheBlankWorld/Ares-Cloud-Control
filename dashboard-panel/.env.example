# ARES Cloud Control - dashboard environment
#
# Data source: "mock" (default, no backend required) or "api" (talks to the Rust agent).
VITE_DATA_SOURCE=mock

# Base URL of the ARES monitoring agent.
# Local:      http://127.0.0.1:9000
# Tunnel:     https://<subdomain>.trycloudflare.com
# Leave empty to let users configure it at runtime in Settings -> Servers.
VITE_AGENT_URL=

# Optional bearer token for the agent. Prefer configuring this per-server in the UI.
VITE_AGENT_TOKEN=
